{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoleRoster",
  "description": "ct1 role roster schema",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "display_name": { "type": "string" },
          "type": { "type": "string", "enum": ["fixed", "execution", "quality", "review", "specialist"] },
          "status": { "type": "string", "enum": ["planned", "ready", "active", "waiting", "completed", "retired", "blocked", "failed", "replaced"] },
          "mission": { "type": "string" },
          "owned_tasks": { "type": "array", "items": { "type": "string" } },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "read_scope": { "type": "array", "items": { "type": "string" } },
          "write_scope": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "activation": { "type": "object", "properties": { "when": { "type": "string" }, "read_only_until": { "type": "string", "description": "事件未触发前角色只读，如 plan_confirmed" } } },
          "deactivation": { "type": "object", "properties": { "when": { "type": "string" } } }
        },
        "required": ["id", "type", "status"]
      }
    }
  },
  "required": ["roles"]
}
